# OpenAI-compatible Agents SDK provider. Defaults target Groq's free plan.
# Keep these server-side; never expose them to the browser.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b

# TypeSafe/Jev server credential. Never expose this to the browser.
TYPESAFE_API_KEY=

# Solana devnet RPC endpoint. Mainnet endpoints are forbidden for this MVP.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# x402 V2 facilitator base URL. Startup must verify /supported before use.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Merchant owner address whose devnet USDC associated token account is funded for rent.
X402_MERCHANT_PAY_TO=

# Fixed local merchant URL and port. Agents cannot override this URL.
X402_MERCHANT_URL=http://127.0.0.1:4021/research
# Keep 127.0.0.1 locally. Public Node hosts normally require 0.0.0.0.
X402_MERCHANT_HOST=127.0.0.1
# A hosting platform's PORT variable takes precedence over this local port.
X402_MERCHANT_PORT=4021

# Local SQLite ledger path. Use one process only for this hackathon MVP.
PACTLET_DATABASE_PATH=./pactlet.db

# Public application origin used to bind wallet-authentication nonces.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Server-only HMAC secret for signed wallet challenges and sessions.
# Use at least 32 random characters. Never expose it with a NEXT_PUBLIC_ prefix.
PACTLET_SESSION_SECRET=

# Server-only AES-256-GCM key for disposable task signer seeds.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Keep the same value across restarts; changing it makes existing task signers unreadable.
PACTLET_SIGNER_MASTER_KEY=
