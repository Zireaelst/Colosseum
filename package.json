{
  "name": "pactlet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "merchant": "tsx --env-file-if-exists=.env merchant/server.ts",
    "spike:x402": "node --experimental-strip-types scripts/spike/x402-compatibility.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openai/agents": "0.20.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.5.1",
    "@solana/sysvars": "5.5.1",
    "@supabase/supabase-js": "2.117.3",
    "@typesafe-ai/sdk": "0.6.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/react": "1.0.3",
    "@wallet-standard/ui-registry": "1.1.1",
    "@x402/core": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/svm": "2.28.0",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
